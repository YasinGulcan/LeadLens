# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth (giriş/kayıt) için tarayıcı/SSR tarafında kullanılan public anahtar — Project Settings > API > Publishable key
SUPABASE_ANON_KEY=

# Gmail API (OAuth2) — CLIENT_ID/SECRET uygulamanın kendi kimliği, tüm
# hesaplar için ortak. REFRESH_TOKEN artık gerekmiyor (her hesap kendi
# token'ını "Google ile Bağlan" akışıyla veritabanına kaydediyor) — sadece
# eski scripts/gmail-auth.ts / scripts/migrate-to-accounts.ts kullanıyorsa gerekir.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Firecrawl
FIRECRAWL_API_KEY=

# OpenAI (embedding)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Uygulamanın canlı adresi (OAuth redirect URI + rapor mailindeki "Panelde görüntüle" linki için)
APP_URL=

# Resend (ikinci bildirim kanalı — Gmail'e ek, opsiyonel — ayrıca email+OTP
# giriş/kayıt kodları ve ekip daveti/sahiplik devri mailleri de bunu kullanır)
RESEND_API_KEY=
SALES_NOTIFICATION_EMAIL=
# RESEND_FROM_EMAIL: Resend'de doğrulanmış bir domain'iniz varsa (SPF/DKIM
# eklenmiş) buraya yazın (örn. "LeadLens <kod@leadlens.app>"). Tanımlı değilse
# Resend'in sandbox adresine ("onboarding@resend.dev") düşülür — bu adres
# SADECE Resend hesabının kendi doğrulanmış e-postasına gönderim yapabilir,
# gerçek kullanıcılara OTP kodu ULAŞMAZ. Domain doğrulanana kadar bu, canlıda
# email+OTP girişini/kaydını gerçek kullanıcılar için engelleyen bir kısıttır.
RESEND_FROM_EMAIL=

# Resend Inbound (Yönlendirme Adresi — bkz. app/api/inbound-email) webhook imza secret'ı
RESEND_INBOUND_WEBHOOK_SECRET=

# Çoklu hesap (multi-tenant) + self-servis Google girişi
# TOKEN_ENCRYPTION_KEY: 32 byte'lık AES-256 anahtarı, base64 (örn. `openssl rand -base64 32`)
TOKEN_ENCRYPTION_KEY=
# OAUTH_STATE_SECRET / SESSION_SECRET: rastgele string (örn. `openssl rand -base64 32`)
OAUTH_STATE_SECRET=
SESSION_SECRET=
